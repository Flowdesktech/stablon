# ─── Firebase (client SDK) ───────────────────────────────────
# Public config from the Firebase console → Project settings → your web app.
# These are exposed in the browser by design.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ─── Firebase Admin (server, service account) ────────────────
# From a service account key (Project settings → Service accounts →
# Generate new private key). Keep the private key's newlines escaped as \n.
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Random secret used to encrypt 2FA TOTP secrets at rest.
# Generate with: openssl rand -base64 32
APP_SECRET=""

# ─── Bridge.xyz ──────────────────────────────────────────────
BRIDGE_API_KEY=""
BRIDGE_API_URL="https://api.bridge.xyz/v0"
# Developer fee (percent) charged on incoming virtual-account deposits. Default 1%.
BRIDGE_DEVELOPER_FEE_PERCENT="1.0"
# Public mirror of the deposit fee, shown in the UI's fee notice. Keep in sync
# with BRIDGE_DEVELOPER_FEE_PERCENT.
NEXT_PUBLIC_BRIDGE_DEVELOPER_FEE_PERCENT="1"
# Optional default on-chain destination address for virtual account onramps.
BRIDGE_ONRAMP_ADDRESS=""
# Per-endpoint RSA public key returned when the Bridge transfer webhook is
# created. Preserve PEM newlines as \n in hosted environment variables.
BRIDGE_WEBHOOK_PUBLIC_KEY=""

# ─── SEO / metadata ──────────────────────────────────────────
# Canonical public URL used for metadata, sitemap, robots, and social cards.
# On Vercel this falls back to the production deployment URL automatically.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ─── Resend (contact-form email) ─────────────────────────────
# API key from https://resend.com → API Keys. Used to deliver contact-form
# submissions to your support inbox.
RESEND_API_KEY=""
# Verified sender for outgoing mail. Use onboarding@resend.dev until you verify
# your own domain in Resend.
CONTACT_FROM_EMAIL="Stablon Support <onboarding@resend.dev>"
# Inbox that receives contact-form submissions.
CONTACT_TO_EMAIL="contact@flowdesk.tech"

# ─── Invoicing ────────────────────────────────────────────────
# Verified sender used for invoice delivery. Recipient replies go directly to
# the business profile's billing email.
INVOICE_FROM_EMAIL="Stablon Invoices <invoices@your-domain.com>"
# Server-side canonical base URL for recurring invoice email links.
INVOICE_BASE_URL="https://your-domain.com"
# Optional percentage deducted from invoice settlements by Bridge (0-10).
INVOICE_DEVELOPER_FEE_PERCENT="0"
# Secures the daily recurring invoice scheduler endpoint. Vercel Cron sends
# this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=""
# Anonymous PDF generator protection. Use an independent random salt.
INVOICE_GENERATOR_RATE_LIMIT="10"
INVOICE_RATE_LIMIT_SALT=""

# ─── NOWPayments (virtual-account setup fee) ─────────────────
# API key and IPN secret from the NOWPayments dashboard (Payment Settings).
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# API base URL. Leave blank for production; for testing use the sandbox host
# (https://api-sandbox.nowpayments.io/v1) together with sandbox credentials.
NOWPAYMENTS_API_URL=""
# One-time fee (USD) charged before a user can create their first virtual
# account. Recovers Bridge's per-account provisioning cost.
VIRTUAL_ACCOUNT_FEE_USD="10"
# Public mirror of the fee amount, shown in the UI's fee notice. Keep in sync
# with VIRTUAL_ACCOUNT_FEE_USD.
NEXT_PUBLIC_VIRTUAL_ACCOUNT_FEE_USD="10"
# Public base URL of the app, used to build NOWPayments ipn/success/cancel URLs.
NEXT_PUBLIC_APP_URL="https://your-domain.com"
